generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum DeliveryType {
  HOME
  DESK
}

enum PaymentMethod {
  COD
  CIB_EDAHABIA
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameFr    String
  nameAr    String
  nameEn    String
  imageUrl  String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                String           @id @default(cuid())
  slug              String           @unique
  titleFr           String
  titleAr           String
  titleEn           String
  descriptionFr     String
  descriptionAr     String
  descriptionEn     String
  priceDzd          Int
  compareAtPriceDzd Int?
  isFeatured        Boolean          @default(false)
  isActive          Boolean          @default(true)
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  images            ProductImage[]
  orderItems        OrderItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String
  colorName     String
  colorHex      String
  stockQuantity Int         @default(0)
  orderItems    OrderItem[]
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int     @default(0)
}

model WilayaShipping {
  code              Int     @id
  nameFr            String
  nameAr            String
  homeDeliveryDzd   Int
  stopDeskDzd       Int
  isActive          Boolean @default(true)
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerName  String
  customerPhone String
  wilayaCode    Int
  wilayaName    String
  commune       String
  address       String?
  deliveryType  DeliveryType  @default(HOME)
  paymentMethod PaymentMethod @default(COD)
  shippingDzd   Int
  subtotalDzd   Int
  totalDzd      Int
  status        OrderStatus   @default(PENDING)
  trackingCode  String?
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int
  unitPriceDzd Int
}